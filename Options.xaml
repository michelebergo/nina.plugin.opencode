<ResourceDictionary
    x:Class="NINA.Plugin.OpenCode.Options"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:NINA.Plugin.OpenCode">

    <BooleanToVisibilityConverter x:Key="OpenCodeOptionsBoolToVisibility" />

    <!-- The key must be "<plugin name>_Options" for NINA to find it. -->
    <DataTemplate x:Key="OpenCode_Options">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical" Margin="10">

                <TextBlock Text="OpenCode" FontSize="18" FontWeight="Bold" Margin="0,0,0,5" />
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,15" FontSize="12" Opacity="0.7">
                    <Run Text="A panel for the opencode agent you already run. This plugin contains no AI and installs nothing:" /><LineBreak />
                    <Run Text="your models, keys, agents and MCP servers stay in your own opencode configuration." /><LineBreak />
                    <Run Text="Install opencode first from https://opencode.ai — the plugin will not download it." />
                </TextBlock>

                <GroupBox Header="Connection" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <TextBlock Text="How to reach the agent" Margin="0,0,0,3" />
                        <ComboBox SelectedValue="{Binding ConnectionMode, Mode=TwoWay}" SelectedValuePath="Content"
                                  HorizontalAlignment="Left" MinWidth="220" Margin="0,0,0,8">
                            <ComboBoxItem Content="Launch" />
                            <ComboBoxItem Content="Attach" />
                        </ComboBox>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7" Margin="0,0,0,8"
                                   Text="Launch starts a local opencode server and stops it when you disconnect. Attach uses one that is already running — on the observatory PC, for instance — and never starts or stops it." />

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <CheckBox IsChecked="{Binding AutoConnect, Mode=TwoWay}" VerticalAlignment="Center" />
                            <TextBlock Text="Connect automatically when the panel is opened"
                                       VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Observatory log" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding RecordObservatoryLog, Mode=TwoWay}" VerticalAlignment="Center" />
                            <TextBlock Text="Write down what changes during the night"
                                       VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7" Margin="0,6,0,0"
                                   Text="Records equipment state changes and one line per saved frame to a file, one file per night. It moves nothing, asks nothing and calls no model — it exists so that what an unattended agent should react to can be decided from what this observatory actually does." />
                        <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7" Margin="0,6,0,0"
                                   Text="{Binding ObservatoryLogStatus}" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Launch a local server" Margin="0,0,0,10"
                          Visibility="{Binding IsLaunchMode, Converter={StaticResource OpenCodeOptionsBoolToVisibility}}">
                    <StackPanel Margin="5">
                        <TextBlock Text="Path to opencode (leave empty to use PATH)" Margin="0,0,0,3" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <TextBox Text="{Binding ExecutablePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     MinWidth="360" VerticalAlignment="Center" />
                            <Button Content="Browse..." Command="{Binding BrowseExecutableCommand}"
                                    Padding="10,2" Margin="5,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding ExecutableStatus}" TextWrapping="Wrap" FontSize="11"
                                   Opacity="0.7" Margin="0,0,0,8" />

                        <TextBlock Text="Port (0 lets the machine pick a free one)" Margin="0,0,0,3" />
                        <TextBox Text="{Binding LaunchPort, Mode=TwoWay}" MinWidth="120"
                                 HorizontalAlignment="Left" Margin="0,0,0,8" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Attach to a running server" Margin="0,0,0,10"
                          Visibility="{Binding IsAttachMode, Converter={StaticResource OpenCodeOptionsBoolToVisibility}}">
                    <StackPanel Margin="5">
                        <TextBlock Text="Server address" Margin="0,0,0,3" />
                        <TextBox Text="{Binding ServerUrl, Mode=TwoWay}" MinWidth="360"
                                 HorizontalAlignment="Left" Margin="0,0,0,8" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Session" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <TextBlock Text="Working directory" Margin="0,0,0,3" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <TextBox Text="{Binding WorkingDirectory, Mode=TwoWay}" MinWidth="360"
                                     VerticalAlignment="Center" />
                            <Button Content="Browse..." Command="{Binding BrowseWorkingDirectoryCommand}"
                                    Padding="10,2" Margin="5,0,0,0" />
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7" Margin="0,0,0,8"
                                   Text="opencode reads its project configuration and AGENTS.md from here, so this is what decides which agents and MCP servers the session gets." />

                        <TextBlock Text="Agent (leave empty for the default)" Margin="0,0,0,3" />
                        <TextBox Text="{Binding AgentName, Mode=TwoWay}" MinWidth="220"
                                 HorizontalAlignment="Left" Margin="0,0,0,8" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="N.I.N.A. tools" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7" Margin="0,0,0,8"
                                   Text="The agent is told it is attached to a running observatory, and given N.I.N.A.&apos;s own tools. Both are written into the working directory as AGENTS.md and opencode.json, and kept up to date as the plugin improves &#8212; the copy they replace is left beside them as .previous. To keep changes of your own instead, delete the line at the top of the file that names this plugin: it is then yours and never touched again. To add an agent of your own without giving that up, put a markdown file in .opencode/agents/ inside the working directory &#8212; that folder is never touched." />

                        <TextBlock Text="Path to nina_advanced_mcp.py" Margin="0,0,0,3" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <TextBox Text="{Binding NinaMcpServerPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     MinWidth="360" VerticalAlignment="Center" />
                            <Button Content="Browse..." Command="{Binding BrowseNinaMcpServerCommand}"
                                    Padding="10,2" Margin="5,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding NinaMcpStatus}" TextWrapping="Wrap" FontSize="11"
                                   Opacity="0.7" Margin="0,0,0,8" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <TextBlock Text="Advanced API host" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Text="{Binding NinaApiHost, Mode=TwoWay}" MinWidth="140" Margin="0,0,12,0" />
                            <TextBlock Text="port" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Text="{Binding NinaApiPort, Mode=TwoWay}" MinWidth="70" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Model" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7" Margin="0,0,0,8"
                                   Text="By default the agent uses whatever provider your opencode is already configured with. A local model instead keeps the night on your own hardware, costs nothing per message, and still works on a site with no usable connection." />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <CheckBox IsChecked="{Binding UseLocalModel, Mode=TwoWay}" VerticalAlignment="Center" />
                            <TextBlock Text="Run on a local model (Ollama)" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>

                        <TextBlock Text="Host" Margin="0,0,0,3" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <TextBox Text="{Binding LocalModelHost, Mode=TwoWay}" MinWidth="260" VerticalAlignment="Center" />
                            <Button Content="Check" Command="{Binding CheckLocalModelsCommand}"
                                    Padding="10,2" Margin="5,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding LocalModelStatus}" TextWrapping="Wrap" FontSize="11"
                                   Opacity="0.7" Margin="0,0,0,8" />

                        <TextBlock Text="Model" Margin="0,0,0,3" />
                        <TextBox Text="{Binding LocalModelId, Mode=TwoWay}" MinWidth="260"
                                 HorizontalAlignment="Left" Margin="0,0,0,3" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Security" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <TextBlock Text="Server password" Margin="0,0,0,3" />
                        <TextBox Text="{Binding ServerPassword, Mode=TwoWay}" MinWidth="260"
                                 HorizontalAlignment="Left" Margin="0,0,0,3" />
                        <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                                   Text="An opencode server with no password accepts a prompt from anything that can reach its port, which on an observatory PC means anything on the network. Left empty, a launched server gets a fresh password each time that is kept in memory only. To attach to a server that has one, enter it here." />
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
